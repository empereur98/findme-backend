          "name": "Create Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Domicile\",\n  \"country\": \"FR\",\n  \"city\": \"Paris\",\n  \"district\": \"1er arrondissement\",\n  \"street\": \"123 Rue de la Paix\",\n  \"landmark\": \"Près de la place Vendôme\",\n  \"gpsLat\": 48.8696,\n  \"gpsLng\": 2.3355,\n  \"type\": \"HOME\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "addresses"]
            },
            "description": "Créer une adresse"
          },
          "response": []
        },
        {
          "name": "Get User Addresses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "addresses"]
            },
            "description": "Récupérer les adresses de l'utilisateur"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "Get Invoices",
          "request": {
            "method": "GET",
