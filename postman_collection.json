        {
          "name": "Reverse Geocode",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/geo/reverse-geocode?lat=48.8566&lng=2.3522",
              "host": ["{{baseUrl}}"],
              "path": ["api", "geo", "reverse-geocode"],
              "query": [
                {
                  "key": "lat",
                  "value": "48.8566"
                },
                {
                  "key": "lng",
                  "value": "2.3522"
