    {
      "name": "Geo",
      "item": [
        {
          "name": "Geocode Address",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/geo/geocode?address=123 Rue de la Paix, Paris",
              "host": ["{{baseUrl}}"],
              "path": ["api", "geo", "geocode"],
              "query": [
                {
                  "key": "address",
                  "value": "123 Rue de la Paix, Paris"
                }
              ]
            },
            "description": "Géocoder une adresse"
          },
          "response": []
